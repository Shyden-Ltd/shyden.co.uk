# Copy to `.env.local` and fill in. `.env.*` is gitignored; this file is not.
# Never commit a real value here.

# DeepL, for `npm run i18n:translate` (#21 Stage 5). Also a repo secret.
#
# FREE PLAN KEYS END `:fx` and are REJECTED by api.deepl.com — the script
# reads that suffix and routes to api-free.deepl.com. Paste the key exactly as
# DeepL gives it, suffix included.
#
# The script DRY RUNS by default and sends nothing without `--send`, so a key
# is only needed when you actually mean to spend quota.
DEEPL_API_KEY=
