#!/bin/sh
#
# Runs the two checks that gate the FIRST step of `build-and-test`, so a
# two-second problem cannot cost a sixteen-minute CI run. PR #34 failed on a
# single over-long line in a test file; because `npm run format` runs first in
# CI, the build, the unit suite and the entire e2e corpus were skipped, and the
# run verified nothing. See #35.
#
# e2e is deliberately NOT here — ~7.3 minutes would make pushing unusable, and
# a hook people bypass every time is worse than no hook. CI remains its gate.
#
# Installed by `scripts/install-hooks.mjs` via `prepare`, which points
# `core.hooksPath` at this directory. Bypass a single push with --no-verify.
set -u

fail() {
  printf '\npre-push blocked: %s\n' "$1"
  printf '  fix:  %s\n' "$2"
  printf '  skip: git push --no-verify   (CI still runs both)\n\n'
  exit 1
}

npm run format || fail 'Prettier found files that are not formatted' 'npx prettier --write .'
npm run test:unit || fail 'a unit test failed' 'npm run test:unit'
