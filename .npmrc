# Turns `engines` in package.json from advisory into a hard install failure.
#
# Without this, npm only WARNS when the running Node is below the declared
# floor and installs anyway, so the real failure surfaces much later at build
# or test time as a confusing runtime error. `.nvmrc` pins CI and nvm users but
# npm never reads it, so this is the only place the contract is enforced for a
# contributor on volta, asdf, fnm, or a system Node. See #31.
engine-strict=true
