---
import { localisePath, otherLocale, type Locale } from '../lib/i18n';
import { siteEn, siteId } from '../lib/i18n/site';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = lang === 'id' ? siteId : siteEn;

// Root-relative (/#…) not bare (#…): the Header renders on every page via
// BaseLayout, but these section anchors live only on the homepage — so bare
// fragments would dead-link on /glory-points and /404. /#services scrolls in
// place on the homepage and navigates home-then-scrolls from any other page.
//
// The home path is locale-aware for the same reason: on /id/* pages a bare
// `/#services` would silently throw the visitor back to the ENGLISH homepage,
// which looks like the site forgetting their language mid-visit.
const home = localisePath('/', lang);
const base = home === '/' ? '' : home.replace(/\/$/, '');
const links = [
  { href: `${base}/#services`, label: t.nav.services },
  { href: `${base}/#work`, label: t.nav.work },
  { href: `${base}/#contact`, label: t.nav.contact },
];

const other = otherLocale(lang);
const otherHref = localisePath(Astro.url.pathname, other);
---

<header>
  <div class="bar">
    <a class="wordmark" href={home}>Shyden</a>
    <details class="menu">
      <summary aria-label={t.menuLabel} aria-controls="primary-nav"
        ><span class="bars"></span></summary
      >
    </details>
    <a
      class="lang"
      href={otherHref}
      hreflang={other}
      lang={other}
      rel="alternate">{t.language.switchTo}</a
    >
    <nav id="primary-nav">
      {
        links.map((l) => (
          <a href={l.href} tabindex="0">
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<style>
  header {
    position: sticky;
    top: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    position: relative;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0.75rem var(--space);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }
  /* Mobile disclosure toggle (the hamburger). */
  .menu > summary {
    list-style: none;
    min-width: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .menu > summary::-webkit-details-marker {
    display: none;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--ink);
    content: '';
  }
  .bars {
    position: relative;
  }
  .bars::before {
    position: absolute;
    top: -7px;
  }
  .bars::after {
    position: absolute;
    top: 7px;
  }
  /* The nav lives OUTSIDE <details> so that at desktop it is a plain flex
     element (a closed <details> wrapper collapses to 0 width and pushes its
     children off-screen on every engine). On mobile it is hidden until the
     disclosure opens, then shown as an absolutely-positioned dropdown. */
  nav {
    display: none;
  }
  @media (max-width: 719.98px) {
    .menu[open] ~ nav {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0.5rem var(--space);
    }
  }
  nav a {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 720px) {
    .menu {
      display: none;
    }
    nav {
      display: flex;
      flex-direction: row;
      gap: 1.5rem;
      position: static;
      padding: 0;
    }
  }
  /* The language link lives in the BAR, not in <nav>.
     Two reasons, both learned from a failing test:
     1. <nav> means "the site's sections" and is pinned to exactly those three
        links; a language control is a different kind of thing.
     2. On mobile <nav> collapses behind the disclosure, which would have
        hidden the switcher behind a hamburger — unreachable for exactly the
        visitors most likely to want it. */
  .lang {
    margin-left: auto;
    margin-right: 1rem;
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
