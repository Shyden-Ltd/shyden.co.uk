---
const links = [
  { href: '#services', label: 'Services' },
  { href: '#work', label: 'Work' },
  { href: '#contact', label: 'Contact' },
];
---

<header>
  <div class="bar">
    <a class="wordmark" href="/">Shyden</a>
    <details class="menu">
      <summary aria-label="Toggle navigation menu" aria-controls="primary-nav"
        ><span class="bars"></span></summary
      >
    </details>
    <nav id="primary-nav">
      {
        links.map((l) => (
          <a href={l.href} tabindex="0">
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<style>
  header {
    position: sticky;
    top: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    position: relative;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0.75rem var(--space);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }
  /* Mobile disclosure toggle (the hamburger). */
  .menu > summary {
    list-style: none;
    min-width: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .menu > summary::-webkit-details-marker {
    display: none;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--ink);
    content: '';
  }
  .bars {
    position: relative;
  }
  .bars::before {
    position: absolute;
    top: -7px;
  }
  .bars::after {
    position: absolute;
    top: 7px;
  }
  /* The nav lives OUTSIDE <details> so that at desktop it is a plain flex
     element (a closed <details> wrapper collapses to 0 width and pushes its
     children off-screen on every engine). On mobile it is hidden until the
     disclosure opens, then shown as an absolutely-positioned dropdown. */
  nav {
    display: none;
  }
  @media (max-width: 719.98px) {
    .menu[open] ~ nav {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0.5rem var(--space);
    }
  }
  nav a {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 720px) {
    .menu {
      display: none;
    }
    nav {
      display: flex;
      flex-direction: row;
      gap: 1.5rem;
      position: static;
      padding: 0;
    }
  }
</style>
