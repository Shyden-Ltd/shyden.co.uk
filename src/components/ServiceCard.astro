---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<article class="service-card">
  <h3>{title}</h3>
  <p><slot /></p>
</article>
<style>
  .service-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  h3 {
    margin-top: 0;
  }
</style>
