---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localisePath, type Locale } from '../../lib/i18n';
import { siteEn, siteId } from '../../lib/i18n/site';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = (lang === 'id' ? siteId : siteEn).notFound;
const home = localisePath('/', lang);
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <section class="wrap">
    <h1>{t.heading}</h1>
    <p>{t.body} <a href={home}>{t.backHome}</a>.</p>
  </section>
</BaseLayout>
<style>
  .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 4rem var(--space);
  }
</style>
