      display: table-header-group;
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      margin: 0;
    }
    #cg-roster tbody {
      display: table-row-group;
    }
    #cg-roster tfoot {
      display: table-footer-group;
    }
    #cg-roster tr {
      display: table-row;
    }
    #cg-roster th,
    #cg-roster td {
      display: table-cell;
      padding: 0.4rem 0.35rem;
      text-align: left;
      vertical-align: middle;
      border-bottom: 1px solid var(--border);
    }
    #cg-roster th {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--ink-soft);
    }
    #cg-roster tfoot td {
      border-bottom: 0;
      padding-top: 0.6rem;
    }
    /* Cancels the card's own border/background/padding -- a table row
       cannot show its own border or background in the separated-borders
       model this table does not use (`border-collapse: collapse`, above),
       but resetting explicitly costs nothing and leaves nothing to the
       collapsing algorithm's own border-conflict resolution to decide. */
    #cg-roster .cg-student {
      display: table-row;
      padding: 0;
      margin-bottom: 0;
      border: 0;
      border-radius: 0;
      background: none;
