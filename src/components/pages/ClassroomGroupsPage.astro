---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStrings, THEME_KEYS, type Locale } from '../../lib/i18n';
// The engine owns the ceiling. Hard-coding a second number here is how the
// field comes to advertise one limit while the tool enforces another.
import { MAX_STUDENTS, type Student } from '../../lib/grouping';
import { sectionState, type ToolState } from '../../lib/sections';
import { sexWhy } from '../../lib/sexOptions';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = getStrings(lang);
// The declared list, not Object.keys of one of the two tables — enumerating
// `themes` while rendering from `themeNames` is how one gains a key the other
// lacks and the option ships with no label.
const themes = THEME_KEYS;

// The three built collapsible sections' headers (Student details, Grouping
// options, Import / export — Sound & animation carries no state string at
// all, see sections.ts) report this state from the moment the page loads,
// computed at build time through the one function that also has a unit test
// pinning it against both locale tables. Every field but `leftovers` stays
// at this default for the whole of this stage: no roster exists yet
// (`rosterSize`/`named`/`absent`/`together`/`apart`), `sexMode` stays `'off'`
// because the two sex switches (rendered inside `#cg-grouping-body` below,
// Stage 2 Task 4) are permanently `disabled` for the same reason (see
// `sexWhyText` below), and nothing can mark the roster `dirty` until a later
// stage gives it something to lose. `leftovers` mirrors the radio group's
// own default further down (`checked` on `spread`) for this build-time
// render only. `classroom-groups.ts` keeps the rendered header live from
// there: its own `change` listener calls this same `sectionState` again
// whenever the leftovers radio changes, and rewrites `#cg-grouping .state`
// — so the header cannot go on reporting "none" once a teacher has picked
// "put them all in one group".
const initialToolState: ToolState = {
  named: 0,
  absent: 0,
  together: 0,
  apart: 0,
  rosterSize: 0,
  sexMode: 'off',
  leftovers: 'spread',
  dirty: false,
};
const sectionStrings = sectionState(initialToolState, t);

// The two sex switches' disabled reason (design spec section 6), computed
// once at build time exactly like `initialToolState` above -- there is no
// roster on this page until stage 3 (`#cg-students-body` below renders
// nothing), so `roster` is `null` for the whole of this stage and there is
// no event anywhere on the page that could ever change it. `sexWhy` always
// returns its "no list at all" message here as a result; the other two
// messages it can produce are real and unit-tested (tests/unit/
// sexOptions.test.ts) but unreachable from this page today. Whichever task
// wires Student details' roster is what turns this into a live value
// classroom-groups.ts recomputes on change, the same way
// `updateGroupingHeader` already does for the leftovers radio below.
const roster: Student[] | null = null;
const sexWhyText = sexWhy(roster, t);
---

<BaseLayout
  title={`${t.title} — Shyden`}
  description={t.description}
  lang={lang}
>
  <section class="wrap">
    <h1>{t.heading}</h1>
    <p class="lead">{t.lead}</p>
    <p class="privacy">{t.privacy}</p>

    <!-- NOT one of the tool's four collapsible sections (student details,
         grouping options, import/export, sound & animation) -- it is the
         page's own summary and description, so it sits above #cg-form and
         outside it, per design spec section 3's "How to use — at the very
         top, outside the tool". One header opens and closes BOTH parts
         together: what this is (who it is for and why it was built, not
         only what it does) and how to use it. Collapsed, #cg-howto-toggle
         itself stays on screen and un-hidden -- a control that hides itself
         is a trap -- and only #cg-howto-body, the content it discloses, ever
         gets `hidden`. A bare <button> has no heading role, so it is wrapped
         in an <h2> here -- matching #cg-results-h below and glory-points'
         own #how-to-heading -- so heading navigation still finds this
         section; the button alone carries the click. -->
    <section id="cg-howto" class="howto">
      <h2 class="howto-heading">
        <button
          type="button"
          class="howto-toggle"
          id="cg-howto-toggle"
          aria-expanded="true"
          aria-controls="cg-howto-body"
        >
          {t.howToHeading}
        </button>
      </h2>
      <!-- EXPANDED in the raw markup -- no `hidden` here, unlike every other
           collapsible section on this page (#cg-students/#cg-grouping/#cg-io/
           #cg-sound below all render `hidden` in their own markup). This is
           the page's own summary and description, not a control: a visitor
           whose script never runs, or fails before reaching this section,
           must still be able to read who this tool is for and why it exists
           (design spec section 3's part 1) -- impossible if `hidden` ships
           in the HTML at all. A code review caught this: the four sections
           below have nothing to disclose until a teacher acts, so shipping
           them `hidden` costs a script-disabled visitor nothing; this
           section IS the content, so shipping it `hidden` would have cost
           that visitor the one paragraph answering "who is this for and
           why".

           Collapsed is still the intended default for everyone else: design
           spec section 2's operator ruling 2 (2026-08-08) reverses this
           section's original expanded-by-default (section 3), measured at
           ~310px on a phone, and section 2 calls it the single biggest
           saving toward the tool fitting one screen. The script immediately
           below enforces that default, synchronously, before paint, for
           every visitor whose script runs -- see its own comment for why a
           raw-HTML default could not deliver both requirements (no-JS
           reachability AND a collapsed JS-enabled default) at once. -->
      <div id="cg-howto-body" class="howto-body">
        <p>{t.howToWhat}</p>
        <ol>
          {t.howToSteps.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </section>

    <!-- Collapses How to use, synchronously, for every visitor whose script
         runs. The markup above ships EXPANDED (see its own comment: a
         script-disabled visitor must still be able to read who this is for
         and why), so without this, every JavaScript visitor would see the
         full intro paragraph and three steps on first paint too -- undoing
         the ~310px design spec section 2's ruling 2 exists to save.
         classroom-groups.ts is a deferred `type="module"` (Astro
         hoists/bundles every plain `<script>` in a `.astro` file that way),
         so it does not run until after the browser has already parsed, and
         typically painted, everything above it -- too late to avoid that
         flash. This runs synchronously, in document order, right after the
         elements it touches -- `is:inline` is required, or Astro would defer
         it exactly the same way.

         Reads the identical key classroom-groups.ts reads
         (`cg-howto-collapsed`), the identical way -- see that file's own
         comment on `HOWTO_KEY` for the full '0'/'1'/absent semantics: '0' is
         the only stored value that means "a teacher left this open";
         anything else -- '1', absent, or a failed read -- means collapse.
         `openPreferred` only ever becomes `true` from an explicit '0': a
         read of '1' or absent, AND a throw, both leave it `false`, so the
         SAME collapse call below covers all three, rather than duplicating
         it once inside the try and once in the catch. Safari's "Block all
         cookies", a partitioned context or an MDM profile all throw
         SecurityError on the mere act of reading localStorage, and this runs
         before classroom-groups.ts exists to catch it -- leaving the section
         uncollapsed on a throw would show the full expanded content through
         first paint, the exact flash this script exists to prevent. -->
    <script is:inline>
      (function () {
        var openPreferred = false;
        try {
          openPreferred = localStorage.getItem('cg-howto-collapsed') === '0';
        } catch {
          openPreferred = false;
        }
        if (!openPreferred) {
          var body = document.getElementById('cg-howto-body');
          var toggle = document.getElementById('cg-howto-toggle');
          if (body) body.hidden = true;
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
        }
      })();
    </script>

    <!-- No `name` on any control that holds something a teacher typed. A form
         with no `action` submits to its OWN url as a GET, so a `name` here
         would put the class list in the address bar, the history and the
         access log the moment the script below fails to attach — which is a
         real state (JS blocked at a school, a 404'd bundle, a throw). The
         radio groups keep theirs because `name` is what binds a radio group
         together, and "students per group" is not personal data.
         Everything else is read by id. Pinned by classroom-groups-privacy.spec.ts. -->
    <form id="cg-form" novalidate>
      <!-- Design spec section 3: "Top row: Class (optional) · Students ·
           Split by" -- one compact row of three parallel fields, replacing
           the two bordered `<fieldset>`s Stage 2 Tasks 1 and 5 shipped
           (`classHeading` "Your class", wrapping Class + Students;
           `groupsHeading` "How to split them", wrapping the mode radios and
           the active size/count field). classroom-groups.spec.ts's own "the
           no-scroll rule, measured" test.fixme block named those two boxes,
           by name, as part of why the collapsed page did not fit -- see
           that file for the measurements this row exists to close.

           Neither legend is missed: every field here already carries its
           own accessible name -- a <label>, or for the mode radios the same
           `aria-labelledby="cg-mode-label"` pattern the naming and
           leftovers radiogroups elsewhere on this page already use -- so
           dropping the two purely organisational headings loses no
           accessible name, only a redundant one. Both keys are removed from
           en.ts/id.ts in the same commit, not left for dead-copy.test.ts to
           catch as unreferenced.

           Mobile-first: `.top-row` is one column, stacked, matching section
           3's own "on a phone they stack" -- see its own CSS comment below
           for the arithmetic on why three fields in a row is not the
           six-controls-in-304px problem section 3 documents for the roster,
           and stacks anyway because the phone always does regardless of
           what geometrically fits. `min-width: 768px` reuses
           `.tool-sections`' own breakpoint just below, for the same
           side-by-side-on-wide transition on the same page. -->
      <div class="top-row">
        <!-- Stage 2, Task 5. Design spec section 3's top row: "Class
             (optional) · Students · Split by" -- this field first, matching
             that order. Optional (section 8: "Blank is fine and nothing is
             blocked"), so it carries no `required`, no pattern and no
             `maxlength` -- a class name has no length this page enforces,
             the same way #cg-count has no roster-shaped limit here either
             (MAX_ROSTER is stage 3's, and governs the roster table, not
             this field).

             No `name`, by the same rule as every other typed-text control
             on this page (see #cg-form's own comment above): a name here
             would put a teacher's class name in the URL, the history and
             the access log the moment the submit listener fails to attach.
             `autocomplete="off"` on top of that -- unlike #cg-count, this
             field holds free text a teacher typed, and the browser's own
             autofill memory is a second place it could persist beyond
             "forgotten when you close the page" (the privacy copy above,
             section 11) that a `type="number"` field never carries.

             `resultsHeadingText` (src/lib/i18n/index.ts) is the one place
             this value is ever turned into the results heading; see its own
             doc comment for why the value it reads is never trimmed. -->
        <div class="field">
          <label for="cg-class">{t.classLabel}</label>
          <input id="cg-class" type="text" autocomplete="off" />
        </div>

        <div class="field">
          <label for="cg-count">{t.studentsLabel}</label>
          <input
            id="cg-count"
            type="number"
            inputmode="numeric"
            min="1"
            max={MAX_STUDENTS}
            value="24"
            aria-describedby="cg-count-help"
          />
          <p class="help" id="cg-count-help">{t.studentsHelp}</p>
        </div>

        <!-- The third top-row column: "Split by (per group / number of
             groups)". `.split-by` carries no styling of its own -- it is a
             grid placement wrapper only, so its three children still stack
             with the SAME `.field` margin they used inside the old
             `groupsHeading` fieldset (see .top-row > .field's own CSS
             comment for why that margin is switched off one level up, on
             Class/Students, but not reached down into here). -->
        <div class="split-by">
          <div class="field">
            <span class="label" id="cg-mode-label">{t.modeLabel}</span>
            <div
              class="radios"
              role="radiogroup"
              aria-labelledby="cg-mode-label"
            >
              <label
                ><input type="radio" name="mode" value="perGroup" checked />{
                  t.modePerGroup
                }</label
              >
              <label
                ><input type="radio" name="mode" value="groupCount" />{
                  t.modeGroupCount
                }</label
              >
            </div>
          </div>

          <div class="field" data-mode="perGroup">
            <label for="cg-size">{t.groupSizeLabel}</label>
            <input
              id="cg-size"
              type="number"
              inputmode="numeric"
              min="1"
              max="50"
              value="4"
            />
          </div>

          <div class="field" data-mode="groupCount" hidden>
            <label for="cg-groups">{t.groupCountLabel}</label>
            <input
              id="cg-groups"
              type="number"
              inputmode="numeric"
              min="1"
              max="50"
              value="6"
            />
          </div>
        </div>
      </div>

      <fieldset>
        <legend>{t.namingLabel}</legend>
        <div class="field">
          <div class="radios" role="radiogroup" aria-label={t.namingLabel}>
            <label
              ><input type="radio" name="naming" value="numbered" checked />{
                t.namingNumbered
              }</label
            >
            <label
              ><input type="radio" name="naming" value="themed" />{
                t.namingThemed
              }</label
            >
          </div>
        </div>
        <div class="field" data-naming="themed" hidden>
          <label for="cg-theme">{t.themeLabel}</label>
          <select id="cg-theme">
            {
              themes.map((key) => (
                <option value={key}>{t.themeNames[key]}</option>
              ))
            }
          </select>
        </div>
      </fieldset>

      <!-- The tool's four collapsible sections (design spec section 3):
           Student details, Grouping options, Import / export and Sound &
           animation, in that order (the spec's own "Student details ·
           Grouping options · Import / export · Sound & animation").

           Sound & animation is the last of the four to be built (Stage 2,
           Task 7). Until now it stayed where it already was, a plain
           `<fieldset><legend>{t.playbackHeading}</legend>...` right above
           this block: its existing checkbox already held `id="cg-sound"`,
           so a fourth section sharing that literal id with its own wrapper
           would have been a duplicate id, and that fieldset already
           rendered the section's whole heading and content on its own —
           an empty `cg-sound`-shaped shell wrapped around or beside it
           would have put a SECOND "Sound and animation" heading on the
           page for content already shown in full. The real fix, done here:
           the fieldset and its `<legend>` are gone; its two controls moved
           unchanged into `#cg-sound-body` below; and the checkbox that used
           to hold `id="cg-sound"` is renamed `cg-sound-check`, freeing
           `cg-sound` for this section's own wrapper — the same id every
           other section here uses for its own (`cg-students`, `cg-grouping`,
           `cg-io`). The rename ripples into every e2e spec file that
           clicked or read the old id — classroom-groups.spec.ts,
           classroom-groups-controls.spec.ts, classroom-groups-privacy.spec.ts,
           classroom-groups-announcements.spec.ts and
           tests/dev/dev-sanity.spec.ts — all updated alongside this file.

           Same control as #cg-howto above, deliberately: a bare toggle
           button loses the heading role the old markup had (see that
           section's own comment), so every one of these wraps its button in
           an <h2> too — the same level, since these are siblings of #cg-howto
           and #cg-results in the page's outline, not a step beneath them.
           The heading carries the level, the button carries the click,
           `aria-expanded` and `aria-controls`. Collapsed by default, the
           same rendered end state #cg-howto above reaches for a JavaScript
           visitor — design spec section 2's rule is that everything in the
           tool starts collapsed and opening is a deliberate act. Unlike
           #cg-howto, though: these four have no reason to ship expanded in
           the raw markup, because none of them hold content a visitor needs
           to read without JavaScript — every one is empty or a control until
           a teacher opens it, JavaScript or not. #cg-howto alone carries the
           page's own summary and description, which is why IT alone ships
           expanded in the HTML and relies on a script to collapse it (see
           its own comment for the reasoning); these four cost a
           script-disabled visitor nothing by shipping `hidden` outright.
           Also unlike #cg-howto, the collapsed state here is never written
           to localStorage: section 11 names exactly two UI preferences
           allowed to persist (the how-to collapsed state, and a later print
           panel) and this is not one of them, so every visit starts
           collapsed.

           Each of the first three buttons' own text is the label, a literal
           `{' · '}` (an expression, not template whitespace — see
           CLAUDE.md's own whitespace-seam rule), then the state span — so
           the DOM text is the real, whole sentence design spec section 3
           shows ("Student details · none added"), not a separator relying
           on surrounding whitespace to survive reformatting. `cg-sound`'s
           button carries none of that: `sectionState` (src/lib/sections.ts)
           returns exactly three fields, not four — pinned by
           tests/unit/sections.test.ts — because sound and speed are
           simple, always-visible preferences, not data a teacher could
           lose by collapsing the section. So this one button is the label
           alone, with no middot and no `.state` span to leave empty or
           invent a value for.

           `cg-students` and `cg-io` are rendered here with no body content
           at all, not a "coming soon" placeholder: that text would ship to
           production if a later stage slipped. Stage 3, Task 2 gives
           `#cg-students-body` real content -- the roster table -- but
           entirely CLIENT-SIDE, from classroom-groups.ts's own "── student
           roster" section (see that file); the markup below is unchanged,
           still an empty div for the reason above, still true of `cg-io`.
           `cg-grouping`'s body holds
           the two sex switches (design spec section 6) and the leftovers
           choice, rehomed here from the fieldset above unchanged (Stage 2,
           Task 4) — same markup, same `name` attribute, same four locale
           keys, still live today. Its header's own state is read LIVE from
           that radio the moment it changes (see classroom-groups.ts's own
           comment on `updateGroupingHeader`), unaffected by where the radio
           physically sits, because the listener delegates on `#cg-form`
           itself. `cg-sound`'s body holds the two controls the removed
           fieldset above used to: same markup, same behaviour, and the same
           ids apart from the checkbox rename this section's own opening
           comment explains. -->
      <div class="tool-sections">
        <section id="cg-students" class="tool-section">
          <h2 class="tool-section-heading">
            <button
              type="button"
              class="tool-section-toggle"
              id="cg-students-toggle"
              aria-expanded="false"
              aria-controls="cg-students-body"
            >
              {t.sectionStudentsHeading}{' · '}<span class="state"
                >{sectionStrings.studentDetails}</span
              >
            </button>
          </h2>
          <div id="cg-students-body" class="tool-section-body" hidden></div>
        </section>

        <section id="cg-grouping" class="tool-section">
          <h2 class="tool-section-heading">
            <button
              type="button"
              class="tool-section-toggle"
              id="cg-grouping-toggle"
              aria-expanded="false"
              aria-controls="cg-grouping-body"
            >
              {t.sectionGroupingHeading}{' · '}<span class="state"
                >{sectionStrings.groupingOptions}</span
              >
            </button>
          </h2>
          <div id="cg-grouping-body" class="tool-section-body" hidden>
            <!-- Both switches are governed by ONE condition (design spec
                 section 6: "disabled unless every student being grouped has
                 M or F"), so they share ONE disabled state and ONE reason
                 paragraph rather than each carrying its own -- two call
                 sites computing the same fact is how a header disagreeing
                 with reality happens elsewhere on this page (see the fix
                 recorded on #cg-grouping's own header, above). `sexWhyText`
                 is `null` for "enabled" (see sexOptions.ts's own doc
                 comment on why), so `disabled={sexWhyText !== null}` and
                 `hidden={sexWhyText === null}` read directly off the one
                 value -- never a bare disabled control with nothing next to
                 it explaining why. -->
            <div class="field">
              <div class="switches">
                <label class="switch"
                  ><input
                    type="checkbox"
                    id="cg-sex-mix"
                    disabled={sexWhyText !== null}
                    aria-describedby="cg-sex-why"
                  /><span>{t.sexMixLabel}</span></label
                >
                <label class="switch"
                  ><input
                    type="checkbox"
                    id="cg-sex-separate"
                    disabled={sexWhyText !== null}
                    aria-describedby="cg-sex-why"
                  /><span>{t.sexSeparateLabel}</span></label
                >
              </div>
              <p class="why" id="cg-sex-why" hidden={sexWhyText === null}>
                {sexWhyText}
              </p>
            </div>

            <!-- Rehomed from the "How to split them" fieldset above,
                 unchanged: same markup, same `name="leftovers"`, same four
                 locale keys (leftoversLabel/Spread/Bunch/Help). It works
                 today and this task is only about where it lives. -->
            <div class="field">
              <span class="label" id="cg-left-label">{t.leftoversLabel}</span>
              <div
                class="radios"
                role="radiogroup"
                aria-labelledby="cg-left-label"
              >
                <label
                  ><input
                    type="radio"
                    name="leftovers"
                    value="spread"
                    checked
                  />{t.leftoversSpread}</label
                >
                <label
                  ><input type="radio" name="leftovers" value="bunch" />{
                    t.leftoversBunch
                  }</label
                >
              </div>
              <p class="help">{t.leftoversHelp}</p>
            </div>
          </div>
        </section>

        <section id="cg-io" class="tool-section">
          <h2 class="tool-section-heading">
            <button
              type="button"
              class="tool-section-toggle"
              id="cg-io-toggle"
              aria-expanded="false"
              aria-controls="cg-io-body"
            >
              {t.sectionImportExportHeading}{' · '}<span class="state"
                >{sectionStrings.importExport}</span
              >
            </button>
          </h2>
          <div id="cg-io-body" class="tool-section-body" hidden></div>
        </section>

        <section id="cg-sound" class="tool-section">
          <h2 class="tool-section-heading">
            <button
              type="button"
              class="tool-section-toggle"
              id="cg-sound-toggle"
              aria-expanded="false"
              aria-controls="cg-sound-body"
            >
              {t.sectionSoundHeading}
            </button>
          </h2>
          <div id="cg-sound-body" class="tool-section-body" hidden>
            <div class="field">
              <label class="switch"
                ><input id="cg-sound-check" type="checkbox" checked /><span
                  id="cg-sound-text">{t.soundOn}</span
                ></label
              >
            </div>
            <div class="field">
              <label for="cg-speed">{t.speedLabel}</label>
              <select id="cg-speed">
                <option value="normal">{t.speedNormal}</option>
                <option value="fast">{t.speedFast}</option>
                <option value="skip">{t.speedSkip}</option>
              </select>
            </div>
          </div>
        </section>
      </div>

      <p class="actions">
        <button type="submit" id="cg-go">{t.makeGroups}</button>
      </p>

      <!-- Without this, a visitor whose browser is not running the script
           presses the button and gets a page reload with nothing to show for
           it — no result and no reason. Says so instead, in their language. -->
      <noscript><p class="error" id="cg-noscript">{t.needsJs}</p></noscript>
    </form>

    <p class="error" id="cg-error" role="alert" hidden></p>

    <!-- The results are written here as real text regardless of animation
         state, so a screen reader, a skipped animation and a finished one all
         expose exactly the same thing.

         The live region is the SUMMARY, not this section. Announcing the
         whole section would read out every group and every child on every
         shuffle; announcing the summary says "5 groups from 22 students" and
         leaves the detail to be read at the visitor's own pace. Either way
         the script must unhide before it writes — a live region that appears
         already-populated is announced by nobody. -->
    <section id="cg-results" aria-labelledby="cg-results-h" hidden>
      <!-- Build-time default is the UNNAMED form. classroom-groups.ts
           overwrites this with resultsHeadingText(classInput.value, t) at
           every submit, through `.textContent` (never `.innerHTML` -- a
           teacher's typed text is theirs, not markup), before this section
           is unhidden. A visitor whose script never attaches sees this
           section stay `hidden` regardless (#cg-noscript covers that
           state), so the static default here is never shown on its own. -->
      <h2 id="cg-results-h">{t.resultsHeading}</h2>

      <!-- Stage 2, Task 6 (design spec section 8, "When the class changes
           after a shuffle"). classroom-groups.ts's `updateStaleness` toggles
           `hidden` on this whole element and adds `.stale` to #cg-results --
           see src/lib/staleness.ts for the comparison behind it. Static
           markup, toggled by the script, the SAME pattern #cg-error and
           #cg-summary already use (hide/show the ancestor, THEN write the
           descendant, so a screen reader hears the sentence rather than
           silence) -- unlike the group cards below, this is a single,
           fixed-shape region, not one repeated per student, so there is no
           reason to build it with document.createElement.

           The button sits OUTSIDE <form id="cg-form"> in the DOM, but
           `form="cg-form"` associates it anyway: clicking it submits the
           SAME form #cg-go does, through the SAME submit handler, so a
           reshuffle triggered from here can never behave differently from
           one triggered from the button up in the form -- one code path,
           not two that could drift apart. This is the "way out" design spec
           section 8 asks the badge to carry, reachable without scrolling
           back up to #cg-go. Reuses `t.again` ("Shuffle again") rather than
           a new key: it performs the identical action, so it earns the
           identical label. -->
      <div class="stale-notice" id="cg-stale" hidden>
        <p role="status" id="cg-stale-text"></p>
        <button type="submit" form="cg-form">{t.again}</button>
      </div>

      <p class="summary" id="cg-summary" role="status"></p>
      <div class="tables" id="cg-tables"></div>
    </section>
  </section>

  <script src="../../scripts/classroom-groups.ts"></script>
</BaseLayout>

<style is:global>
  /* ── results ─────────────────────────────────────────────────────────────
     GLOBAL, not scoped, because the script BUILDS these elements at runtime.

     Astro scopes a component's styles by stamping `data-astro-cid-…` onto the
     elements in its template and compiling every rule to match it. Nothing
     created by document.createElement carries that attribute, so a scoped
     `.avatar` rule compiled to `.avatar[data-astro-cid-vs67owv4]` matched
     none of the avatars this page actually renders. The whole results area
     shipped unstyled: 202px black circles instead of 34px coloured faces, a
     list-item instead of a row, no card border, and a deal animation that
     never animated because `.student { opacity: 0 }` never applied either.

     Every test passed throughout, because they all counted elements and read
     text. A real phone showed it in one screenshot.

     Anchored on #cg-results so these generic names — .group, .student,
     .avatar, .who — cannot reach any other page. Pinned by
     classroom-groups-controls.spec.ts, which asserts rendered sizes and
     computed colours rather than class names. */
  #cg-results .group {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 1rem 1rem;
  }
  #cg-results .group h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }
  #cg-results .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  #cg-results .student {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    /* Dealt in by the script. Starting hidden means a half-finished deal never
       shows a card in a nonsense position; `.dealt` is added per card. */
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.96);
  }
  #cg-results .student.dealt {
    opacity: 1;
    transform: none;
    transition:
      opacity 220ms ease-out,
      transform 220ms ease-out;
  }
  #cg-results .avatar {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    border-radius: 50%;
  }
  /* Per-student colour arrives as --hue, so the SVG markup itself stays a
     constant with nothing interpolated into it. */
  #cg-results .a-bg {
