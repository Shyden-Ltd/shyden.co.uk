---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStrings, THEME_KEYS, type Locale } from '../../lib/i18n';
// The engine owns the ceiling. Hard-coding a second number here is how the
// field comes to advertise one limit while the tool enforces another.
import { MAX_STUDENTS } from '../../lib/grouping';
import { sectionState, type ToolState } from '../../lib/sections';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = getStrings(lang);
// The declared list, not Object.keys of one of the two tables — enumerating
// `themes` while rendering from `themeNames` is how one gains a key the other
// lacks and the option ships with no label.
const themes = THEME_KEYS;

// The three built collapsible sections' headers (Student details, Grouping
// options, Import / export — Sound & animation carries no state string at
// all, see sections.ts) report this state from the moment the page loads,
// computed at build time through the one function that also has a unit test
// pinning it against both locale tables. Every field but `leftovers` stays
// at this default for the whole of this stage: no roster exists yet
// (`rosterSize`/`named`/`absent`/`together`/`apart`), the sex switches are
// not wired until Grouping options gets its own task, and nothing can mark
// the roster `dirty` until a later stage gives it something to lose.
// `leftovers` mirrors the radio group's own default further down (`checked`
// on `spread`) — that control has not moved into `#cg-grouping` yet, and
// wiring this header to follow it live if a teacher changes it before then
// is left for the task that gives the two a shared home, so a header never
// promises to track a control it is not yet standing next to.
const initialToolState: ToolState = {
  named: 0,
  absent: 0,
  together: 0,
  apart: 0,
  rosterSize: 0,
  sexMode: 'off',
  leftovers: 'spread',
  dirty: false,
};
const sectionStrings = sectionState(initialToolState, t);
---

<BaseLayout
  title={`${t.title} — Shyden`}
  description={t.description}
  lang={lang}
>
  <section class="wrap">
    <h1>{t.heading}</h1>
    <p class="lead">{t.lead}</p>
    <p class="privacy">{t.privacy}</p>

    <!-- NOT one of the tool's four collapsible sections (student details,
         grouping options, import/export, sound & animation) -- it is the
         page's own summary and description, so it sits above #cg-form and
         outside it, per design spec section 3's "How to use — at the very
         top, outside the tool". One header opens and closes BOTH parts
         together: what this is (who it is for and why it was built, not
         only what it does) and how to use it. Collapsed, #cg-howto-toggle
         itself stays on screen and un-hidden -- a control that hides itself
         is a trap -- and only #cg-howto-body, the content it discloses, ever
         gets `hidden`. A bare <button> has no heading role, so it is wrapped
         in an <h2> here -- matching #cg-results-h below and glory-points'
         own #how-to-heading -- so heading navigation still finds this
         section; the button alone carries the click. -->
    <section id="cg-howto" class="howto">
      <h2 class="howto-heading">
        <button
          type="button"
          class="howto-toggle"
          id="cg-howto-toggle"
          aria-expanded="true"
          aria-controls="cg-howto-body"
        >
          {t.howToHeading}
        </button>
      </h2>
      <div id="cg-howto-body" class="howto-body">
        <p>{t.howToWhat}</p>
        <ol>
          {t.howToSteps.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </section>

    <!-- No `name` on any control that holds something a teacher typed. A form
         with no `action` submits to its OWN url as a GET, so a `name` here
         would put the class list in the address bar, the history and the
         access log the moment the script below fails to attach — which is a
         real state (JS blocked at a school, a 404'd bundle, a throw). The
         radio groups keep theirs because `name` is what binds a radio group
         together, and "students per group" is not personal data.
         Everything else is read by id. Pinned by classroom-groups-privacy.spec.ts. -->
    <form id="cg-form" novalidate>
      <fieldset>
        <legend>{t.classHeading}</legend>

        <div class="field">
          <label for="cg-count">{t.studentsLabel}</label>
          <input
            id="cg-count"
            type="number"
            inputmode="numeric"
            min="1"
            max={MAX_STUDENTS}
            value="24"
            aria-describedby="cg-count-help"
          />
          <p class="help" id="cg-count-help">{t.studentsHelp}</p>
        </div>
      </fieldset>

      <fieldset>
        <legend>{t.groupsHeading}</legend>

        <div class="field">
          <span class="label" id="cg-mode-label">{t.modeLabel}</span>
          <div class="radios" role="radiogroup" aria-labelledby="cg-mode-label">
            <label
              ><input type="radio" name="mode" value="perGroup" checked />{
                t.modePerGroup
              }</label
            >
            <label
              ><input type="radio" name="mode" value="groupCount" />{
                t.modeGroupCount
              }</label
            >
          </div>
        </div>

        <div class="field" data-mode="perGroup">
          <label for="cg-size">{t.groupSizeLabel}</label>
          <input
            id="cg-size"
            type="number"
            inputmode="numeric"
            min="1"
            max="50"
            value="4"
          />
        </div>

        <div class="field" data-mode="groupCount" hidden>
          <label for="cg-groups">{t.groupCountLabel}</label>
          <input
            id="cg-groups"
            type="number"
            inputmode="numeric"
            min="1"
            max="50"
            value="6"
          />
        </div>

        <div class="field">
          <span class="label" id="cg-left-label">{t.leftoversLabel}</span>
          <div class="radios" role="radiogroup" aria-labelledby="cg-left-label">
            <label
              ><input type="radio" name="leftovers" value="spread" checked />{
                t.leftoversSpread
              }</label
            >
            <label
              ><input type="radio" name="leftovers" value="bunch" />{
                t.leftoversBunch
              }</label
            >
          </div>
          <p class="help">{t.leftoversHelp}</p>
        </div>
      </fieldset>

      <fieldset>
        <legend>{t.namingLabel}</legend>
        <div class="field">
          <div class="radios" role="radiogroup" aria-label={t.namingLabel}>
            <label
              ><input type="radio" name="naming" value="numbered" checked />{
                t.namingNumbered
              }</label
            >
            <label
              ><input type="radio" name="naming" value="themed" />{
                t.namingThemed
              }</label
            >
          </div>
        </div>
        <div class="field" data-naming="themed" hidden>
          <label for="cg-theme">{t.themeLabel}</label>
          <select id="cg-theme">
            {
              themes.map((key) => (
                <option value={key}>{t.themeNames[key]}</option>
              ))
            }
          </select>
        </div>
      </fieldset>

      <fieldset>
        <legend>{t.playbackHeading}</legend>
        <div class="field">
          <label class="switch"
            ><input id="cg-sound" type="checkbox" checked /><span
              id="cg-sound-text">{t.soundOn}</span
            ></label
          >
        </div>
        <div class="field">
          <label for="cg-speed">{t.speedLabel}</label>
          <select id="cg-speed">
            <option value="normal">{t.speedNormal}</option>
            <option value="fast">{t.speedFast}</option>
            <option value="skip">{t.speedSkip}</option>
          </select>
        </div>
      </fieldset>

      <!-- The tool's four collapsible sections (design spec section 3):
           Student details, Grouping options, Import / export and Sound &
           animation. Only three exist here — Sound & animation stays where
           it already is, in the fieldset above, because its existing
           checkbox already holds `id="cg-sound"`; a fourth section sharing
           that id with the wrapper would be a duplicate id, and renaming
           the checkbox ripples into three other e2e spec files that are not
           this task's to change. A later task owns giving sound its own
           section and making that rename.

           Same control as #cg-howto above, deliberately: a bare toggle
           button loses the heading role the old markup had (see that
           section's own comment), so every one of these wraps its button in
           an <h2> too — the same level, since these are siblings of #cg-howto
           and #cg-results in the page's outline, not a step beneath them.
           The heading carries the level, the button carries the click,
           `aria-expanded` and `aria-controls`. Collapsed by default — unlike
           #cg-howto — because design spec section 2's rule is that
           everything in the tool starts collapsed and opening is a
           deliberate act; #cg-howto is the page's own summary, not part of
           the tool, which is why it alone defaults open. Also unlike
           #cg-howto, the collapsed state here is never written to
           localStorage: section 11 names exactly two UI preferences allowed
           to persist (the how-to collapsed state, and a later print panel)
           and this is not one of them, so every visit starts collapsed.

           Each button's own text is the label, a literal `{' · '}` (an
           expression, not template whitespace — see CLAUDE.md's own
           whitespace-seam rule), then the state span — so the DOM text is
           the real, whole sentence design spec section 3 shows
           ("Student details · none added"), not a separator relying on
           surrounding whitespace to survive reformatting.

           Both `cg-students` and `cg-io` are rendered with no body content
           at all, not a "coming soon" placeholder: that text would ship to
           production if a later stage slipped. `cg-grouping`'s body is
           equally empty here — the leftovers radios below still belong to
           the top-level form until the task that rehomes them, and until
           then this section's own header state is computed from that
           control's default value, not read from it live (see the
           frontmatter comment on `initialToolState` above). -->
      <div class="tool-sections">
        <section id="cg-students" class="tool-section">
          <h2 class="tool-section-heading">
            <button
              type="button"
              class="tool-section-toggle"
              id="cg-students-toggle"
              aria-expanded="false"
              aria-controls="cg-students-body"
            >
              {t.sectionStudentsHeading}{' · '}<span class="state"
                >{sectionStrings.studentDetails}</span
              >
            </button>
          </h2>
          <div id="cg-students-body" class="tool-section-body" hidden></div>
        </section>

        <section id="cg-grouping" class="tool-section">
          <h2 class="tool-section-heading">
            <button
              type="button"
              class="tool-section-toggle"
              id="cg-grouping-toggle"
              aria-expanded="false"
              aria-controls="cg-grouping-body"
            >
              {t.sectionGroupingHeading}{' · '}<span class="state"
                >{sectionStrings.groupingOptions}</span
              >
            </button>
          </h2>
          <div id="cg-grouping-body" class="tool-section-body" hidden></div>
        </section>

        <section id="cg-io" class="tool-section">
          <h2 class="tool-section-heading">
            <button
              type="button"
              class="tool-section-toggle"
              id="cg-io-toggle"
              aria-expanded="false"
              aria-controls="cg-io-body"
            >
              {t.sectionImportExportHeading}{' · '}<span class="state"
                >{sectionStrings.importExport}</span
              >
            </button>
          </h2>
          <div id="cg-io-body" class="tool-section-body" hidden></div>
        </section>
      </div>

      <p class="actions">
        <button type="submit" id="cg-go">{t.makeGroups}</button>
      </p>

      <!-- Without this, a visitor whose browser is not running the script
           presses the button and gets a page reload with nothing to show for
           it — no result and no reason. Says so instead, in their language. -->
      <noscript><p class="error" id="cg-noscript">{t.needsJs}</p></noscript>
    </form>

    <p class="error" id="cg-error" role="alert" hidden></p>

    <!-- The results are written here as real text regardless of animation
         state, so a screen reader, a skipped animation and a finished one all
         expose exactly the same thing.

         The live region is the SUMMARY, not this section. Announcing the
         whole section would read out every group and every child on every
         shuffle; announcing the summary says "5 groups from 22 students" and
         leaves the detail to be read at the visitor's own pace. Either way
         the script must unhide before it writes — a live region that appears
         already-populated is announced by nobody. -->
    <section id="cg-results" aria-labelledby="cg-results-h" hidden>
      <h2 id="cg-results-h">{t.resultsHeading}</h2>
      <p class="summary" id="cg-summary" role="status"></p>
      <div class="tables" id="cg-tables"></div>
    </section>
  </section>

  <script src="../../scripts/classroom-groups.ts"></script>
</BaseLayout>

<style is:global>
  /* ── results ─────────────────────────────────────────────────────────────
     GLOBAL, not scoped, because the script BUILDS these elements at runtime.

     Astro scopes a component's styles by stamping `data-astro-cid-…` onto the
     elements in its template and compiling every rule to match it. Nothing
     created by document.createElement carries that attribute, so a scoped
     `.avatar` rule compiled to `.avatar[data-astro-cid-vs67owv4]` matched
     none of the avatars this page actually renders. The whole results area
     shipped unstyled: 202px black circles instead of 34px coloured faces, a
     list-item instead of a row, no card border, and a deal animation that
     never animated because `.student { opacity: 0 }` never applied either.

     Every test passed throughout, because they all counted elements and read
     text. A real phone showed it in one screenshot.

     Anchored on #cg-results so these generic names — .group, .student,
     .avatar, .who — cannot reach any other page. Pinned by
     classroom-groups-controls.spec.ts, which asserts rendered sizes and
     computed colours rather than class names. */
  #cg-results .group {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 1rem 1rem;
  }
  #cg-results .group h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }
  #cg-results .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  #cg-results .student {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    /* Dealt in by the script. Starting hidden means a half-finished deal never
       shows a card in a nonsense position; `.dealt` is added per card. */
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.96);
  }
  #cg-results .student.dealt {
    opacity: 1;
    transform: none;
    transition:
      opacity 220ms ease-out,
      transform 220ms ease-out;
  }
  #cg-results .avatar {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    border-radius: 50%;
  }
  /* Per-student colour arrives as --hue, so the SVG markup itself stays a
     constant with nothing interpolated into it. */
  #cg-results .a-bg {
    fill: hsl(var(--hue) 62% 88%);
  }
  #cg-results .a-head,
  #cg-results .a-body {
    fill: hsl(var(--hue) 45% 38%);
  }
  #cg-results .who {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>

<style>
  .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 3rem var(--space);
  }
  .lead {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .privacy {
    color: var(--ink-soft);
    max-width: var(--measure);
    font-size: 0.95rem;
  }
  .howto {
    max-width: var(--measure);
    margin-bottom: 1.5rem;
  }
  /* The <h2> wrapper exists for its heading role, not its box -- zero its
     margin so the button's own 44px row is still the whole visual header,
     unchanged from before the wrap. */
  .howto-heading {
    margin: 0;
  }
  /* Reset to plain text so this reads as a header, not a native button --
     full width and 44px tall, per CLAUDE.md's touch-target rule, so the
     whole row is the tap target rather than just the glyph or the words. */
  .howto-toggle {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0;
    font: inherit;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
  }
  /* Decorative only -- aria-expanded is what actually reports state to
     assistive tech. Rotates rather than swapping glyphs, so open and closed
     share one character and cannot drift into mismatched icons. */
  .howto-toggle::before {
    content: '▸ ';
    display: inline-block;
    transition: transform 150ms ease-out;
  }
  .howto-toggle[aria-expanded='true']::before {
    transform: rotate(90deg);
  }
  .howto-body p {
    color: var(--ink-soft);
  }
  .howto-body ol {
    padding-left: 1.2rem;
    margin: 0.75rem 0 0;
  }
  .howto-body li {
    margin-bottom: 0.35rem;
  }

  form {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0;
  }
  fieldset {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    margin: 0;
  }
  legend {
    font-weight: 700;
    padding: 0 0.35rem;
  }
  .field {
    margin-bottom: 1rem;
  }
  .field:last-child {
    margin-bottom: 0;
  }
  label,
  .label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .help {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin: 0.35rem 0 0;
    max-width: var(--measure);
  }
  input[type='number'],
  textarea,
  select {
    width: 100%;
    max-width: 22rem;
    /* 44px minimum touch target (CLAUDE.md).
       Safari ignores min-height on a native `menulist` control: both selects
       on this page rendered 25px tall on WebKit — every iPhone — while
       Chromium honoured the rule and showed 44. So the native appearance is
       reset and the arrow drawn here instead, inline rather than as a request
       (no third-party assets, per CLAUDE.md). */
    appearance: none;
    -webkit-appearance: none;
    min-height: 44px;
    padding: 0.5rem 2.2rem 0.5rem 0.6rem;
    font: inherit;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' fill='none' stroke='%23444' stroke-width='2' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 0.75rem center;
    background-size: 0.7rem;
    color: var(--ink);
  }
  textarea {
    max-width: var(--measure);
    resize: vertical;
  }
  .radios {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .radios label,
  .switch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 400;
    min-height: 44px;
  }
  .radios input,
  .switch input {
    width: 1.15rem;
    height: 1.15rem;
  }
  /* Mobile-first: one column, stacked -- design spec section 3's
     "Arrangement B" is the ENHANCEMENT, not the base. `auto` rows (not a
     fixed height) so an empty body and a later, filled one can sit in the
     same grid without one dictating the other's height. */
  .tool-sections {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0.25rem 0;
  }
  @media (min-width: 768px) {
    .tool-sections {
      grid-template-columns: 1fr 1fr;
    }
  }
  .tool-section {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0 1rem;
  }
  /* Same reasoning as .howto-heading above: the <h2> is for its role, not
     its box. */
  .tool-section-heading {
    margin: 0;
  }
  /* Deliberately the SAME rule set as .howto-toggle above, not a rewrite --
     see this section's own comment in the markup on why these share one
     pattern. */
  .tool-section-toggle {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 44px;
    padding: 0.75rem 0;
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
  }
  .tool-section-toggle::before {
    content: '▸ ';
    display: inline-block;
    transition: transform 150ms ease-out;
  }
  .tool-section-toggle[aria-expanded='true']::before {
    transform: rotate(90deg);
  }
  /* Regular weight against the label's bold, so the fixed name and the
     part that actually changes read as visually distinct. */
  .tool-section-toggle .state {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .tool-section-body:not([hidden]) {
    padding-bottom: 1rem;
  }
  .actions button {
    min-height: 44px;
    padding: 0.6rem 1.4rem;
    font: inherit;
    font-weight: 700;
    color: #fff;
    background: var(--accent, #0a7d66);
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }
  .actions button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .error {
    max-width: var(--measure);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    border: 1px solid #b3261e;
    color: #8c1d18;
    background: #fdecea;
  }

  .tables {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 560px) {
    .tables {
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    }
  }

  /* Someone who asked their device for less motion gets the result with no
     movement at all, even if the animation runs. */
  @media (prefers-reduced-motion: reduce) {
    #cg-results .student,
    #cg-results .student.dealt {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
