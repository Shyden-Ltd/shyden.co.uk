  @media (min-width: 600px) {
    #cg-roster {
      display: table;
      table-layout: fixed;
    }
    #cg-roster col:nth-child(1) {
      width: 8%;
    }
    #cg-roster col:nth-child(2) {
      width: 26%;
    }
    #cg-roster col:nth-child(3) {
      width: 14%;
    }
    #cg-roster col:nth-child(4) {
      width: 14%;
    }
    #cg-roster col:nth-child(5) {
      width: 19%;
    }
    #cg-roster col:nth-child(6) {
      width: 19%;
    }
