---
import { localeNativeNames } from '../lib/i18n/metadata';

/**
 * The Aurora language band (#17), carried across from the Kinetic direction
 * and recoloured into mint so the page reads as one design rather than two.
 *
 * DECORATIVE, and marked so. It is an atmosphere strip, not information: a
 * screen reader gets nothing from a list scrolling past twice, and the
 * languages it names are already available from the switcher in the header.
 *
 * The list is DERIVED from the locales the site serves, where the approved
 * artifact writes it by hand. That means it cannot fall behind a locale that
 * is added, and — the half that matters — it cannot name a language the site
 * does not serve. `tests/unit/marquee.test.ts` pins the endonyms literally.
 *
 * No JavaScript: one CSS keyframe, which the global `prefers-reduced-motion`
 * rule in tokens.css already reduces to a stop.
 */
const run = `${localeNativeNames().join(' ✱ ')} ✱ `;

// Two IDENTICAL halves, so translating the track by exactly -50% lands the
// second half where the first began and the loop has no seam. Repeating the
// run inside each half is what keeps a wide viewport covered.
const half = run.repeat(2);
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <span>{half}</span>
    <span>{half}</span>
  </div>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    margin-block: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    padding-block: 0.5rem;
    background: var(--accent);
    /* Not --ink: mint is a light ground, and --ink on it is 1.4:1. The whole
       reason --on-accent exists (#17). */
    color: var(--on-accent);
    box-shadow: 0 0 50px var(--accent-glow);
    /* The tilt is the point of the band. `scale` covers the corners the
       rotation would otherwise leave bare; the parent clips the overflow,
       which is what keeps a 320px viewport from scrolling sideways. */
    transform: rotate(-1.6deg) scale(1.05);
  }

  .marquee-track {
    display: flex;
    inline-size: max-content;
    animation: marquee-slide 30s linear infinite;
  }

  .marquee-track span {
    padding-inline-end: 1.6rem;
    white-space: nowrap;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(0.9rem, 0.8rem + 0.5vw, 1.15rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  @keyframes marquee-slide {
    to {
      transform: translateX(-50%);
    }
  }
</style>
