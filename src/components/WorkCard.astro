---
import { SHYTALK_MARK } from '../lib/shytalk-brand';

interface Props {
  title: string;
  href: string;
  external?: boolean;
  variant?: 'default' | 'shytalk';
}
const { title, href, external = false, variant = 'default' } = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a
  class:list={['work-card', variant !== 'default' && `work-card--${variant}`]}
  href={href}
  rel={rel}
  target={target}
  aria-label={title}
>
  {
    /* `logo` slot lets a card render a brand wordmark in place of the text
      title; falls back to the plain title. aria-label keeps the accessible
      name = title regardless of the visual treatment. */
  }
  <h3><slot name="logo">{title}</slot></h3>
  <p><slot /></p>
</a>
<style
  define:vars={{
    shytalkTile: SHYTALK_MARK.tile,
    shytalkEdge: SHYTALK_MARK.edge,
    shytalkMuted: SHYTALK_MARK.muted,
    shytalkTalk: SHYTALK_MARK.talk,
  }}
>
  .work-card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-decoration: none;
    color: var(--ink);
  }
  .work-card:hover {
    border-color: var(--accent);
  }
  .work-card h3 {
    margin: 0 0 0.5rem;
  }
  /* ShyTalk brand tile: renders the ShyTalk logo in its native context — the
     dark background from shytalk.shyden.co.uk — so the wordmark reads as the
     real logo, not a recoloured approximation. The wordmark's own colours are
     set on .shytalk-wordmark in the consuming page (Astro slot scoping). */
  .work-card--shytalk {
    background: var(--shytalkTile);
    border-color: var(--shytalkEdge);
    color: var(--shytalkMuted);
  }
  .work-card--shytalk:hover {
    border-color: var(--shytalkTalk);
  }
</style>
