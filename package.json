{
  "name": "shyden-co-uk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:ios": "vitest run --config vitest.ios.config.ts --reporter=verbose",
