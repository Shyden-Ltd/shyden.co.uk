    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "^5.0.0"
  }
